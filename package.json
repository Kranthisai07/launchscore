{
  "name": "launchscore",
  "version": "0.0.1",
  "description": "Scan a live website for security, SEO, accessibility, performance, and hygiene issues.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@12.6.0",
  "bin": {
    "launchscore": "./dist/cli.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "fixture": "tsx fixtures/serve.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.browser.test.ts\"",
    "test:browser": "vitest run .browser.test.",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "commander": "^12.1.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
